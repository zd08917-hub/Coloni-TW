# Настройки сервера
PORT=8787
MAP_SEED=20261106

# Канал Twitch. Если пусто — включается демо-режим (подписчики приходят сами)
TWITCH_CHANNEL=

# Необязательно: EventSub даёт точные события подписки и отписки.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Токен владельца канала (broadcaster) со скоупом channel:read:subscriptions.
# Нужен для channel.subscribe / channel.subscription.end / channel.subscription.gift.
TWITCH_USER_TOKEN=

# Аккаунт-бот и его токен (chat:read + chat:edit).
# Нужен и для чтения подписок из чата, и для ответов игры в чат.
TWITCH_BOT_LOGIN=
TWITCH_BOT_TOKEN=

# Тихий режим: не объявлять голосования в чат (только прибытия, набеги, уровни)
QUIET_CHAT=0

# Разрешить команду !прийти всем, а не только подписчикам
ALLOW_ALL_JOIN=0

# Сколько человек доселять автоматически при каждом обновлении списков (раз в минуту). 0 — выкл
AUTO_ADD_PER_MIN=3
